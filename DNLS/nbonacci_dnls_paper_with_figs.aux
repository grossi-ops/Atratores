\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces $D_2$ values for Fibonacci (blue) and tribonacci (red) chains versus system size $N$ at $T = 10^4$, $\lambda = 1.5$, extracted from the IPR by OLS regression at each $N$. The approach from the linear-limit values (dashed lines, from Figure~\ref {fig:d2natural}) is visible; the tribonacci $D_2$ approaches from below, indicating a faster approach to the extended limit.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:fss_T1e4}{{7}{13}{$D_2$ values for Fibonacci (blue) and tribonacci (red) chains versus system size $N$ at $T = 10^4$, $\lambda = 1.5$, extracted from the IPR by OLS regression at each $N$. The approach from the linear-limit values (dashed lines, from Figure~\ref {fig:d2natural}) is visible; the tribonacci $D_2$ approaches from below, indicating a faster approach to the extended limit}{figure.caption.10}{}}
