import asyncio
import time
from datetime import datetime
from py_clob_client_v2 import ClobClient, OrderArgs, OrderType, Side
from config import *
from utils import *

client = None
daily_pnl = 0.0
trades_today = 0
last_date = datetime.now().date()

async def init():
    global client
    client = ClobClient("https://clob.polymarket.com", key=POLY_KEY, chain_id=137, funder=POLY_FUNDER)
    if not PAPER_MODE:
        creds = client.create_or_derive_api_key()
        client.set_api_creds(creds)
    asyncio.create_task(binance_momentum_stream())
    send_alert("🚀 Bonereaper-Style Bot Started", f"Paper: {PAPER_MODE} | 5m BTC", 0x00ff00)

async def main():
    global daily_pnl, trades_today, last_date
    await init()

    while True:
        try:
            if datetime.now().date() != last_date:
                daily_pnl = trades_today = 0
                last_date = datetime.now().date()

            if trades_today >= MAX_TRADES_DAY or daily_pnl <= -DAILY_LOSS_USD:
                await asyncio.sleep(60)
                continue

            market = find_current_5m_btc_market()
            if not market or market["liquidity"] < MIN_LIQUIDITY:
                await asyncio.sleep(5)
                continue

            # Late window logic
            # (In production, parse exact end time from market title or use timestamp logic)
            now = time.time()
            # Assume we check frequently; enter only in final ~25s when gap is clear

            if len(prices) < 50:
                await asyncio.sleep(5)
                continue

            recent_change = (prices[-1] - prices[-30]) / prices[-30]  # ~30s momentum

            # Get current market price for Yes (Up)
            book = client.get_order_book(market["yes_token"])
            yes_price = float(book.get("asks", [{}])[0].get("price", 0.5))

            # Simple gap edge: strong move but price not fully reflected
            if abs(recent_change) > 0.002 and abs(yes_price - 0.5) < 0.35:  # mispricing
                direction = "UP" if recent_change > 0 else "DOWN"
                side = Side.BUY if direction == "UP" else Side.SELL
                price_to_use = yes_price if direction == "UP" else (1 - yes_price)

                if price_to_use < 0.9:  # only when still cheap
                    size = TRADE_USD / price_to_use
                    alert = f"**{direction}** Gap | Mom: {recent_change*100:+.2f}% | Price: {yes_price:.3f}"

                    if PAPER_MODE:
                        send_alert(f"🧪 PAPER {direction}", alert, 0xFFA500)
                    else:
                        order = client.create_and_post_order(
                            OrderArgs(token_id=market["yes_token"], price=price_to_use, size=size, side=side),
                            OrderType.GTC
                        )
                        send_alert(f"✅ LIVE {direction}", alert)

                    trades_today += 1
                    # Update rough PnL tracking...

            await asyncio.sleep(3)  # poll frequently near window end

        except Exception as e:
            send_alert("⚠️ Error", str(e)[:500], 0xff0000)
            await asyncio.sleep(10)

if __name__ == "__main__":
    asyncio.run(main())

