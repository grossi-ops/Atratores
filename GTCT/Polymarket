import asyncio
import json
import requests
import time
from discord_webhook import DiscordWebhook, DiscordEmbed
import websockets
from config import *

prices = []  # shared latest prices

async def binance_momentum_stream():
    async with websockets.connect("wss://stream.binance.com:9443/ws/btcusdt@trade") as ws:
        while True:
            try:
                msg = await asyncio.wait_for(ws.recv(), 8)
                p = float(json.loads(msg)["p"])
                prices.append(p)
                if len(prices) > 500:
                    prices.pop(0)
            except:
                await asyncio.sleep(1)

def find_current_5m_btc_market():
    try:
        r = requests.get("https://gamma-api.polymarket.com/markets", 
                        params={"active": True, "limit": 100})
        for m in r.json():
            title = m.get("title", "").lower()
            if "bitcoin up or down" in title and "5m" in title or "5 min" in title:
                for t in m.get("tokens", []):
                    if t.get("outcome") == "Yes":
                        return {
                            "yes_token": t["token_id"],
                            "title": m["title"],
                            "liquidity": m.get("liquidity", 0)
                        }
    except:
        pass
    return None

def send_alert(title, desc, color=0x00ff00):
    if not DISCORD_WEBHOOK: return
    wh = DiscordWebhook(url=DISCORD_WEBHOOK)
    emb = DiscordEmbed(title=title, description=desc, color=color)
    wh.add_embed(emb)
    wh.execute()

